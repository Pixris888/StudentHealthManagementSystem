# ============================================================
# 大学生健康管理平台 · 环境变量示例
#
# 本地开发：把需要的变量导出到 IDE / shell，或复制为 .env 后自行加载。
# Docker：复制到 deploy/compose/.env，Compose 会自动读取。
# 不要提交真实密码和 Key。
# ============================================================

# ---------- MySQL ----------
# 本地开发默认 localhost；Docker Compose 内部会自动覆盖为 mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_management
DB_USERNAME=root
DB_PASSWORD=change-me

# 仅 Docker Compose 首次初始化全新 MySQL 数据目录时使用
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- Redis ----------
# 本地开发默认 localhost；Docker Compose 内部会自动覆盖为 redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# ---------- AI 健康助手 ----------
# bailian=阿里百炼，ollama=本地 Ollama，mock=不调用真实模型
AI_PROVIDER=bailian
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
DASHSCOPE_API_KEY=
AI_FALLBACK_ENABLED=false

# ---------- 文件存储 ----------
# local=本地磁盘，oss=阿里云 OSS
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
BACKUP_DIR=./backup

# OSS 模式才需要
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 其他 ----------
TZ=Asia/Shanghai
