# 复制到 /etc/nginx/conf.d/health.conf
# 把 pc.example.com / app.example.com、证书路径替换成实际值
# 如果 Nginx >= 1.25，listen 443 ssl http2 会提示弃用，可改成：
#   listen 443 ssl;
#   http2 on;
# 如果暂时没有证书，先参考 docs/服务器部署说明.md 的“无域名 HTTP 方案”

# ---------- PC 管理端 ----------
server {
    listen 80;
    server_name pc.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pc.example.com;

    ssl_certificate     /etc/nginx/ssl/pc.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/pc.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root  /var/www/health-pc;
    index index.html;
    client_max_body_size 20m;

    include /etc/nginx/snippets/health-api.conf;

    # 学生端下载页 + APK：PC 域名下也能直接扫码下载
    location /download/ {
        alias /var/www/download/;
        index index.html;
    }

    location = /download {
        return 301 /download/;
    }

    location = /download/health-app.apk {
        alias /var/www/download/health-app.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition "attachment";
        add_header Cache-Control "no-store";
    }

    # PC 使用 history 路由，刷新 /ai 等地址必须回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------- 学生端 H5 + APK 下载 ----------
server {
    listen 80;
    server_name app.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.example.com;

    ssl_certificate     /etc/nginx/ssl/app.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/app.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root  /var/www/health-app;
    index index.html;
    client_max_body_size 20m;

    include /etc/nginx/snippets/health-api.conf;

    # 下载页（deploy/download/index.html + logo-192.png）
    location /download/ {
        alias /var/www/download/;
        index index.html;
    }

    location = /download {
        return 301 /download/;
    }

    # APK 的 MIME 和强制下载
    location = /download/health-app.apk {
        alias /var/www/download/health-app.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition "attachment";
        add_header Cache-Control "no-store";
    }

    # H5 使用 hash 路由，正常静态文件即可
    location / {
        try_files $uri $uri/ /index.html;
    }
}
