# 复制到 /opt/health/app/.env，chmod 600，chown health:health
# 这是 systemd EnvironmentFile，不要写 export

# 数据库（建议使用 127.0.0.1 的专用账号，不要用 root）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=health_management
DB_USERNAME=health
DB_PASSWORD=change-me-strong-password

# Redis（仅本机访问时密码可为空）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里百炼 API Key（不要提交到仓库）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# JWT 签名密钥，生成：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# 本地上传/备份/日志目录
UPLOAD_DIR=/opt/health/upload
BACKUP_DIR=/opt/health/backup
LOG_DIR=/opt/health/logs

# 服务器没有安装 Ollama 时保持 false；百炼失败后直接走规则兜底
AI_FALLBACK_ENABLED=false
