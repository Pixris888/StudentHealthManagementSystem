# 服务器位置：/opt/project/backend/.env，chmod 600
# docker --env-file 读取，不要写 export

# 数据库：使用专用账号 health，不要用 root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=health_management
DB_USERNAME=health
DB_PASSWORD=<在服务器上创建 health 用户时设置的密码>

# Redis（Docker 中的 redis 容器）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<Redis 密码，无密码则留空>

# 阿里百炼 API Key
DASHSCOPE_API_KEY=<百炼 Key>

# JWT 签名密钥，服务器执行 openssl rand -hex 32 生成
JWT_SECRET=<openssl rand -hex 32>

# 容器内/宿主机目录（与 docker run 的挂载保持一致）
UPLOAD_DIR=/opt/project/files
BACKUP_DIR=/opt/project/backup
LOG_DIR=/opt/project/logs

# 服务器没有 Ollama，保持 false
AI_FALLBACK_ENABLED=false

# 容器时区
TZ=Asia/Shanghai
