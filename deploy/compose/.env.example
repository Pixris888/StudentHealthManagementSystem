# 复制为 .env 后填写真实值，并执行 chmod 600 .env
# 位置：/opt/project/compose/.env
# 不要提交到 Git

# ---------- 数据库 ----------
# Compose 内部通过服务名访问；如果手动运行后端容器，才改成 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_NAME=health_management
DB_USERNAME=health
DB_PASSWORD=change-me-strong-password

# 仅首次初始化全新 MySQL 数据目录时使用；已有数据目录会忽略
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 建议只使用字母、数字和 @_-，避免空格、引号、$ 导致启动脚本解析异常
REDIS_PASSWORD=change-me-redis-password

# ---------- 应用密钥 ----------
# 阿里百炼 API Key，没有则留空
DASHSCOPE_API_KEY=
# 生成：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# ---------- 目录（与 compose 挂载路径保持一致） ----------
UPLOAD_DIR=/opt/project/files
BACKUP_DIR=/opt/project/backup
LOG_DIR=/opt/project/logs

# 服务器没有 Ollama 时保持 false
AI_FALLBACK_ENABLED=false
TZ=Asia/Shanghai
