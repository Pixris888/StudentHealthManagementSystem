# H5 开发默认走 Vite 代理（/api -> http://127.0.0.1:8888），无需设置。
# 如果后端端口不是 8888：
# VITE_PROXY_TARGET=http://127.0.0.1:8889

# App 真机调试 / 正式构建时，接口必须使用绝对地址。
# 真机调试改成电脑局域网 IP（手机与电脑同一 Wi-Fi）：
# VITE_API_BASE_URL=http://192.168.1.20:8888/api
# 正式环境使用 HTTPS 域名：
# VITE_API_BASE_URL=https://health.example.com/api

# H5 生产构建如果不同源，也需要设置为后端完整地址：
# VITE_API_BASE_URL=https://health.example.com/api
