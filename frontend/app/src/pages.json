{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/register/index",
      "style": {
        "navigationBarTitleText": "注册账号",
        "navigationBarBackgroundColor": "#F5F8F7",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "健康管理",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/checkin/index",
      "style": {
        "navigationBarTitleText": "健康打卡",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/ai/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "AI 健康助手",
        "disableScroll": true
      }
    },
    {
      "path": "pages/knowledge/index",
      "style": {
        "navigationBarTitleText": "健康知识",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/checkin/edit",
      "style": {
        "navigationBarTitleText": "填写打卡"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "健康档案"
      }
    },
    {
      "path": "pages/physical/index",
      "style": {
        "navigationBarTitleText": "体测成绩",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/physical/edit",
      "style": {
        "navigationBarTitleText": "体测记录"
      }
    },
    {
      "path": "pages/report/index",
      "style": {
        "navigationBarTitleText": "我的健康报告",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/messages/index",
      "style": {
        "navigationBarTitleText": "消息中心",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/messages/detail",
      "style": {
        "navigationBarTitleText": "消息详情"
      }
    },
    {
      "path": "pages/knowledge/detail",
      "style": {
        "navigationBarTitleText": "文章详情"
      }
    },
    {
      "path": "pages/ai/history",
      "style": {
        "navigationBarTitleText": "问答历史",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/ai/plans",
      "style": {
        "navigationBarTitleText": "我的健康计划",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/change-password/index",
      "style": {
        "navigationBarTitleText": "修改密码"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "健康管理",
    "navigationBarBackgroundColor": "#F5F8F7",
    "backgroundColor": "#F4F7F6",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#94A3B8",
    "selectedColor": "#0F9D8A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/checkin/index",
        "text": "打卡",
        "iconPath": "static/tabbar/checkin.png",
        "selectedIconPath": "static/tabbar/checkin-active.png"
      },
      {
        "pagePath": "pages/ai/index",
        "text": "AI 助手",
        "iconPath": "static/tabbar/ai.png",
        "selectedIconPath": "static/tabbar/ai-active.png"
      },
      {
        "pagePath": "pages/knowledge/index",
        "text": "知识",
        "iconPath": "static/tabbar/knowledge.png",
        "selectedIconPath": "static/tabbar/knowledge-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  },
  "h5": {
    "title": "大学生健康管理平台",
    "router": {
      "mode": "hash"
    }
  }
}
